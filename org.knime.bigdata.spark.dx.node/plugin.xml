<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.knime.workbench.repository.categories">
      <category
            level-id="sql"
            name="SQL"
            path="/toolintegration/spark">
      </category>
      <category
            level-id="row"
            name="Row"
            path="/toolintegration/spark">
      </category>
      <category
            level-id="convert"
            name="Convert"
            path="/toolintegration/spark">
      </category>
      <category
            level-id="extract"
            name="Extract"
            path="/toolintegration/spark">
      </category>
      <category
            level-id="preproc"
            name="Preprocessing"
            path="/toolintegration/spark">
      </category>
   </extension>
   <extension
         point="org.knime.bigdata.spark.core.SparkNodeFactoryProvider">
      <SparkNodeFactoryProvider
            ProviderClass="org.knime.bigdata.spark.dx.node.DxSparkNodeFactoryProvider">
      </SparkNodeFactoryProvider>
   </extension>
   <extension
         point="org.knime.bigdata.spark.core.SparkJarProvider">
      <SparkJarProvider
            ProviderClass="org.knime.bigdata.spark.dx.node.DxSparkJarProvider">
      </SparkJarProvider>
   </extension>
</plugin>
